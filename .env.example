# ==============================================================================
# Online Store - Environment Variables Configuration
# ==============================================================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/online-store

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# CORS (optional for production domain whitelisting, leave blank for all origins)
ALLOWED_ORIGINS=

# Cloudinary Media Storage (optional - leave blank if not using media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI Assistant (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

